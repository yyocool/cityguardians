# CITY GUARDIANS 게임 서버 설정의 본보기.
# 이 파일을 server/.env 로 복사한 뒤 값을 채운다. .env 는 저장소에 올리지 않는다 (.gitignore).
# 비밀번호와 키는 여기(본보기)나 문서에 적지 않는다.

# dev, test, staging, production. production 과 staging 에서는 마이그레이션을 적용할 때 확인 옵션이 더 필요하다.
APP_ENV=dev

# ── DB ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=city_guardians_dev
DB_USER=
DB_PASS=

# ── 게임 API ──
# 접속 토큰의 수명(시간).
SESSION_HOURS=24
# 한 주소에서 만들 수 있는 게스트 계정 수 (1시간), 토큰 발급 시도 수 (10분).
GUEST_PER_HOUR=20
TOKEN_PER_10MIN=30
# 점검 중이면 1. 상태 확인(/health)만 답한다.
MAINTENANCE=0
# 이보다 낮은 판의 클라이언트에는 업데이트를 안내한다. 비워 두면 확인하지 않는다.
MIN_CLIENT_VERSION=

# ── 도시 위험도 ──
# 1: 요청이 올 때 밀린 침공 판정을 따라잡는다 (예약 작업이 없어도 돌아간다).
# 0: 예약 작업(bin/tick.php)만 판정을 처리한다.
WORLD_LAZY_TICK=1

# ── 관리자 ──
# 0 으로 두면 HTTPS 가 아니어도 관리자 쿠키를 보낸다. 내 PC 에서 시험할 때만 0 으로 둔다.
ADMIN_COOKIE_SECURE=1
# 관리자 화면에 들어올 수 있는 주소 (쉼표로 구분). 비워 두면 제한하지 않는다.
ADMIN_ALLOW_IPS=
# 한 주소에서 할 수 있는 관리자 로그인 시도 수 (10분).
ADMIN_LOGIN_PER_10MIN=10

# ── 현실 혜택: CITY PASS · SCHOLARSHIP (docs/REAL_WORLD_REWARDS_POLICY.md) ──
# 네 기능(멤버십, 쿠폰, 장학 신청, 장학 지급 기록)은 처음에 모두 꺼져 있다. 켜는 것은 관리자 화면의 "현실 혜택 기능"에서
# 법률 검토 결과를 기록한 뒤, 다른 관리자가 한다. 여기에는 켜는 설정이 없다.
# 1 로 두면 관리자 화면의 상태와 관계없이 네 기능이 모두 꺼진다 (급히 멈춰야 할 때).
BENEFITS_LOCKED=0
# 장학 신청서의 개인정보를 암호화하는 키 (base64 로 적은 32바이트). `php bin/new-data-key.php` 로 만든다.
# 비워 두면 장학 신청 기능을 켤 수 없다. 이 키를 잃으면 저장된 신청서를 읽을 수 없고, 새면 암호화가 소용없다:
# 저장소·문서·채팅에 적지 말고, DB 백업과 다른 곳에 따로 보관한다.
DATA_KEY=
# 홈페이지의 바깥 주소 (예: https://www.example.com/cg). 쿠폰 QR 과 장학 신청·보호자 동의 주소를 만들 때 쓴다.
# 비워 두면 QR 에는 주소 없이 코드만 들어가고, 게임은 홈페이지 주소를 안내하지 못한다.
PUBLIC_BASE_URL=
# 0 으로 두면 HTTPS 가 아니어도 홈페이지·상점 화면의 쿠키를 보낸다. 내 PC 에서 시험할 때만 0 으로 둔다.
WEB_COOKIE_SECURE=1
# 한 주소에서 할 수 있는 홈페이지 로그인(일회용 코드) 시도 수, 상점 계정 로그인 시도 수 (10분).
WEB_LOGIN_PER_10MIN=10
MERCHANT_LOGIN_PER_10MIN=10
# 제휴 문의를 받는 이메일. 비워 두면 제휴 문의 페이지에 "준비 중"이라고 나온다.
PARTNER_CONTACT_EMAIL=

# ── v9.0 협동 타워디펜스의 실시간 서버 (docs/COOP_DEFENSE_SYSTEM.md 4장) ──
# 게임 서버와 실시간 서버가 나눠 갖는 서명 키 (32자 이상의 무작위 값). 입장권과 내부 요청에 서명한다.
# 두 서버의 환경변수에만 둔다. 저장소·문서·채팅에 적지 않는다. 비워 두면 협동 방어전은 열리지 않는다
# (관리자 화면에서 켜도 "실시간 서버가 준비되지 않음"으로 나온다).
REALTIME_SECRET=
# 플레이어에게 알려 줄 실시간 서버의 주소 (예: wss://rt.example.com/ws). 운영에서는 wss:// 만 받는다.
# ws:// 는 127.0.0.1 과 localhost 에서만 받는다 (내 PC 에서 시험할 때).
REALTIME_URL=

# ── v9.0 지역 콘텐츠 배포 (docs/CITY_MODELING_PIPELINE.md 5장) ──
# 상징거리 콘텐츠(Addressables 카탈로그와 번들)를 올려 둔 주소의 앞부분 (https:// 만 받는다).
# 비워 두면 관리자 화면에서 콘텐츠를 배포할 수 없고, 클라이언트는 내장된 기본 거리만 쓴다.
CONTENT_BASE_URL=