<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity 에디터 없이 게임 코드(Input, Gameplay, UI, PlayMode 테스트)의 형식 검사만 한다 (docs/TEST_PLAN.md).
    실행하지 않는다. 만들어진 DLL 은 쓰지 않는다. "컴파일 오류가 없다"만 확인하는 수단이다.

    - UnityEngine.* 는 공개된 참조용 어셈블리(UnityEngine.Modules, tools/check/get-refs.ps1 이 받는다)를 쓴다. 프로젝트의 Unity 는 6000.3.28f1 이고
      참조용은 6000.3.26 이다. 같은 6000.3 계열이라 이 프로젝트가 쓰는 API 는 같다.
    - Unity.InputSystem 은 1.5.0 참조용이다 (프로젝트는 1.20.1). Keyboard / Mouse 기본 API 만 쓴다.
    - UnityEngine.UI, Unity.AI.Navigation, UnityEngine.TestTools 는 참조용 어셈블리가 없어
      ../stubs 의 선언만 있는 대역을 쓴다. 대역에 없는 멤버를 쓰면 오류가 난다. 그때는 Unity 문서를 보고 대역에 더한다.
    - Editor 폴더(UnityEditor 필요)는 검사하지 않는다.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>CG.Unity.Check</AssemblyName>
    <RootNamespace>CityGuardians</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0169;CS0618;CS0436;NU1701;NUnit2005;NUnit2006;NUnit2007</NoWarn>
    <DefineConstants>$(DefineConstants);UNITY_INCLUDE_TESTS;UNITY_6000_0_OR_NEWER;ENABLE_INPUT_SYSTEM</DefineConstants>
    <ClientRoot>..\..\..\client\Assets\CityGuardians</ClientRoot>
  </PropertyGroup>

  <!-- 참조용 어셈블리는 ../get-refs.ps1 이 ../.cache 에 받아 둔다. -->
  <Target Name="CheckUnityRefs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('..\.cache\um\lib\netstandard2.0\UnityEngine.CoreModule.dll')"
           Text="Unity 참조용 어셈블리가 없습니다. 먼저 tools/check/get-refs.ps1 을 실행하세요." />
  </Target>

  <ItemGroup>
    <Reference Include="..\.cache\um\lib\netstandard2.0\*.dll" Private="false" />
    <Reference Include="..\.cache\is\lib\netstandard2.0\*.dll" Private="false" />
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(ClientRoot)\Domain\**\*.cs" LinkBase="Domain" />
    <Compile Include="$(ClientRoot)\Services\**\*.cs" LinkBase="Services" />
    <Compile Include="$(ClientRoot)\Input\**\*.cs" LinkBase="Input" />
    <Compile Include="$(ClientRoot)\Gameplay\**\*.cs" LinkBase="Gameplay" />
    <Compile Include="$(ClientRoot)\UI\**\*.cs" LinkBase="UI" />
    <Compile Include="$(ClientRoot)\Tests\**\*.cs" LinkBase="Tests" />
    <Compile Include="..\stubs\UnityUiStubs.cs" Link="Stubs\UnityUiStubs.cs" />
    <Compile Include="..\stubs\UnityNavigationStubs.cs" Link="Stubs\UnityNavigationStubs.cs" />
    <Compile Include="..\stubs\UnityTestStubs.cs" Link="Stubs\UnityTestStubs.cs" />
  </ItemGroup>

</Project>
