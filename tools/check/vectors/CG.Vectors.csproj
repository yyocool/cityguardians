<Project Sdk="Microsoft.NET.Sdk">

  <!--
    클라이언트의 규칙 코드(C#)로 "입력 → 결과" 표본과 초기 콘텐츠 값을 뽑아 server/tests/fixtures 에 쓴다.
    서버(PHP)의 테스트가 이 표본을 읽어 같은 입력에 같은 결과가 나오는지 확인한다 (docs/TEST_PLAN.md).
    서버의 초기 데이터(server/migrations/0003, 0004)도 여기서 나온 값으로 만든다 (server/bin/gen-seed.php).

    실행:  tools/check/vectors 폴더에서 dotnet run
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>CityGuardians.Vectors</RootNamespace>
    <AssemblyName>CG.Vectors</AssemblyName>
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0169</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ClientRoot>..\..\..\client\Assets\CityGuardians</ClientRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Domain 은 UnityEngine 을 쓰지 않는 순수 C# 이다. -->
    <Compile Include="$(ClientRoot)\Domain\**\*.cs" LinkBase="Domain" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
